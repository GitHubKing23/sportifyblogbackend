# Environment configuration for production
NODE_ENV=production

# ✅ Frontend URL for CORS (Make sure it matches your frontend domain)
FRONTEND_URL=https://sportifyinsider.com

# ✅ API Server Port
PORT=5001

# ✅ JWT Secret (For user authentication, if applicable)
JWT_SECRET=your_secure_jwt_secret_here

# Admin wallet allowed to post via CMS (only this address can create/update/delete/feature)
ADMIN_WALLET_ADDRESS=0x3ff964e530ece8587da1b67d9a43de5d734ef0de

# ✅ Logging Level (Set to "debug" for more info in logs)
LOG_LEVEL=info

# ✅ Cloud Storage (If using AWS S3 or other storage solutions in the future)
CLOUD_STORAGE_URL=

# ✅ WebSocket URL (If using real-time updates)
WEBSOCKET_URL=wss://api.sportifyinsider.com

# Example: To update the MongoDB URI, replace the value below
# MONGO_URI=mongodb+srv://newuser:newpassword@cluster0.ylwiw.mongodb.net/blog-database?retryWrites=true&w=majority&appName=Cluster0

# ArangoDB configuration (if you migrate to ArangoDB)
ARANGO_URL=http://184.105.7.228:8529
ARANGO_DB=SportifyBlogs
ARANGO_COLLECTION=blogposts
ARANGO_USER=root
ARANGO_PASS=lovelife123
