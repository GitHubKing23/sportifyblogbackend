# Production example environment (no secrets)
NODE_ENV=production
PORT=5001

# ArangoDB (required)
ARANGO_URL=http://your-arango-host:8529
ARANGO_DB=SportifyBlogs
ARANGO_COLLECTION=blogposts
ARANGO_USER=your_arango_user
ARANGO_PASS=your_arango_password

# JWT secret
JWT_SECRET=change_this_to_a_secure_value

# Frontend URL for CORS
FRONTEND_URL=https://sportifyinsider.com

# Admin wallet allowed to post via CMS (optional)
ADMIN_WALLET_ADDRESS=0x3ff964e530ece8587da1b67d9a43de5d734ef0de

